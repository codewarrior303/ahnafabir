# Contact form delivery
# Set at least one email provider for production. Resend is recommended.
# Get an API key from https://resend.com/api-keys
RESEND_API_KEY=

# Optional Gmail SMTP fallback (Google Account > Security > App passwords).
# Use an App Password, not your regular Gmail password.
GMAIL_APP_PASSWORD=

# Inbox that receives contact form messages (defaults to src/lib/site.ts email).
CONTACT_EMAIL=abirahnafshahriar@gmail.com

# Optional Google Analytics 4 measurement ID (format: G-XXXXXXXXXX).
# Leave blank to keep Google Analytics disabled.
NEXT_PUBLIC_GA_ID=
